mixin option(list, level = 0, parentId = "")
  each item in list
    - const prefix = "--".repeat(level)
    option(value=item.id
    selected=(parentId == item.id)? true: false
    ) #{prefix} #{item.name}
    if(item.children && item.children.length > 0)
      +option(item.children, level + 1, parentId) 