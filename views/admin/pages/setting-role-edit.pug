extends ../layouts/default.pug

block main
    h2.box-title #{pageTitle}
    .section-8
        form#setting-role-edit-form
            .inner-group(style="display: none;")
                input(type="text" name="id" value=roleDetail.id)
            .inner-group
                label(class="inner-label" for="name") Tên nhóm quyền
                input(type="text" id="name" name="name" value = roleDetail.name)
            .inner-group
                label(class="inner-label" for="description") Mô tả ngắn
                input(type="text" id="description" name="description" value = roleDetail.description)
            .inner-group
                label(class="inner-label") Phân quyền 
                .inner-checkbox-list
                    each item in permissionList
                        .inner-checkbox-item
                            input(type="checkbox" name="permissions" value=item.value checked = roleDetail.permissions.includes(item.value))
                            label #{item.label}
            .inner-button.inner-two-col
                button Cập nhật
        .inner-back
                a(href=`/${pathAdmin}/setting/list-role`) Quay lại danh sách
