extends ../layouts/default.pug

block main
    h2.box-title Thông tin cá nhân
    //- Section-8
    .section-8
        form#profile-edit-form
            .inner-group 
                label(class="inner-label" for="name") Họ tên
                input(type="text" id="name" name="name" value=profileAcc.fullName)
            .inner-group 
                label(class="inner-label" for="email") Email
                input(type="text" id="email" name="email" value=profileAcc.email)
            .inner-group 
                label(class="inner-label" for="phone") Số điện thoại
                input(type="number" id="phone" name="phone" value=profileAcc.phone)
            .inner-group 
                label(class="inner-label" for="positionCompany") Chức vụ
                input(type="text" id="positionCompany" name="positionCompany" value=profileAcc.positionCompany readonly)
            .inner-group 
                label(class="inner-label" for="role") Nhóm quyền
                input(type="text" id="role" name="role" value=profileAcc.roleName readonly)
            .inner-group.inner-two-col
                label(class="inner-label" for="logo") Ảnh đại diện
                div(class="inner-upload-image" image-default=profileAcc.logo)
                    input(type="file" id="logo" name="avatar" accept="image/*" filepond-image)
            .inner-group.inner-button
                button Cập nhật
        .inner-back 
            a(href=`/${pathAdmin}/user/changePassword`) Đổi mật khẩu
    //-End Section-8