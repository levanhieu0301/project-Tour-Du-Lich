extends ../layouts/default.pug


block main
    h2.box-title Quản lý đơn hàng
    //- Section-4
    .section-4
        .inner-wrap
            .inner-item.inner-label
                <i class="fa-solid fa-filter"></i> Bộ lọc
            .inner-item
                select
                    option(value="") Trạng thái
                    option(value="") Khởi tạo
                    option(value="") Đã duyệt
            .inner-item.inner-date
                input(type="date")
                span -
                input(type="date")
            .inner-item
                select
                    option(value="") Phương thức thanh toán
                    option(value="") Tiền mặt 
                    option(value="") Ví Momo 
            .inner-item
                select
                    option(value="") Trạng thái thanh toán
                    option(value="") Hoàn thành 
                    option(value="") Chưa thanh toán
            .inner-item.inner-reset
                <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End section-4
    .section-5 
        .inner-wrap  
            .inner-search 
                <i class="fa-solid fa-magnifying-glass"></i>
                input(type="text" placeholder="Tìm kiếm")
    //- End Section-5
    //- Section-3
    .section-3 
        .table-1 
            table 
                thead
                    tr 
                        th Mã
                        th Thông tin khách
                        th Danh sách tour
                        th Thanh toán
                        th Trạng thái
                        th.inner-text-right Ngày đặt
                        th Hành động
                tbody
                    each order in orderList
                        tr 
                            td.inner-code #{order.code}
                            td 
                                div Họ tên: #{order.fullName}
                                div SĐT:#{order.phone}
                                div Ghi chú: #{order.note} 
                            td 
                                .inner-list 
                                    each item in order.items
                                        .inner-item 
                                            .inner-image 
                                                img(src=item.avatar, alt=item.name)
                                            .inner-content 
                                                .inner-name #{item.name}
                                                .inner-quantity Người lớn: #{item.quantityAdult} x #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                                                .inner-quantity Trẻ em: #{item.quantityChildren} x #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                                                .inner-quantity Em bé: #{item.quantityBaby} x #{item.priceNewBaby.toLocaleString("vi-VN")}đ
                            td 
                                div Tổng tiền: #{order.subTotal}
                                div Giảm: 0đ
                                div Mã giảm: 
                                div Thanh toán: #{order.total}
                                div PTTT: #{order.paymentMethodName}
                                div TTTT: #{order.paymentStatusName}
                            td
                                div(class = `badge badge-${order.statusColor}`)  #{order.statusName}
                                //- .badge.badge-green Đã duyệt
                                //- .badge.badge-red Đã hủy
                            td.inner-text-right 
                                div #{order.createdAtFormatTime}
                                div #{order.createdAtFormatDate}
                            td 
                                .inner-buttons
                                    a(href=`/${pathAdmin}/order/edit/${order.id}` class="inner-edit") <i class="fa-regular fa-pen-to-square"></i>
                                    button(
                                        class="inner-delete"
                                        button-delete
                                        data-api=`/${pathAdmin}/order/delete/${order.id}`
                                    ) <i class="fa-regular fa-trash-can"></i>
    //- End Section-3 
    //- Section-7
    .section-7 
        span(class="inner-label") Hiển thị 1 - 9 của 78
        select(class="inner-pagination")
            option Trang 1
            option Trang 2
            option Trang 3
    //- End Section-7
