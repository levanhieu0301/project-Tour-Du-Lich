extends ../layouts/default.pug
include ../mixins/option.pug

block main
    h2.box-title Quản lý tour
    //- Section-4
    .section-4
        .inner-wrap
            .inner-item.inner-label
                <i class="fa-solid fa-filter"></i> Bộ lọc
            .inner-item
                select(select-status)
                    option(value="") Trạng thái
                    option(value="active") Hoạt động
                    option(value="inactive") Tạm dừng
            .inner-item
                select(createdBy)
                    option(value="") Người tạo
                    each item in accountAdminList
                        option(value=item.id) #{item.fullName}
            .inner-item.inner-date
                input(type="date" start-date)
                span -
                input(type="date" end-date)
            .inner-item
                select(select-category)
                    option(value="") Danh mục
                    +option(listCategory)
            .inner-item
                select
                    option(value="") Mức giá
                    option(value="") Dưới 1tr
                    option(value="") Trên 5tr
            .inner-item.inner-reset(reset)
                <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End section-4
    //- Section-5
    .section-5 
        .inner-wrap 
            .inner-change-status(change-multi-tour data-api="/admin/tours/change-multi")
                .inner-item
                    select 
                        option(value="") --Hành động--  
                        option(value="active") Hoạt động 
                        option(value="inactive") Tạm dừng
                        option(value="delete") Xóa 
                .inner-item 
                    button Áp dụng 
            .inner-search 
                <i class="fa-solid fa-magnifying-glass"></i>
                input(type="text" placeholder="Tìm kiếm" search)
            .inner-button-create 
                a(href="/admin/tours/create")  + Tạo mới
            .inner-buton-trash
                button Thùng rác
    //- End Section-5
    //- Section-6
    .section-6
        .table-2
            table
                thead
                    tr
                        th(class="inner-center")
                            input(type="checkbox" class="inner-check" check-all-tour)
                        th Tên tour
                        th Ảnh đại diện
                        th Giá
                        th Còn lại
                        th(class="inner-center") Vị trí
                        th(class="inner-center") Trạng thái
                        th Tạo bởi
                        th Cập nhật bởi
                        th Hành động
                tbody
                    each item in tourList
                        tr
                            td(class="inner-center")
                                input(type="checkbox" class="inner-check" check-item-tour = item.id)
                            td #{item.name}
                            td
                                img(src=item.avatar class="inner-avatar")
                            td
                                div NL: #{item.priceNewAdult > 0 ? item.priceNewAdult.toLocaleString('vi-VN') : item.priceAdult.toLocaleString('vi-VN')}đ
                                div TE: #{item.priceNewChildren > 0 ? item.priceNewChildren.toLocaleString('vi-VN') : item.priceChildren.toLocaleString('vi-VN')}đ
                                div EB: #{item.priceNewBaby > 0 ? item.priceNewBaby.toLocaleString('vi-VN') : item.priceBaby.toLocaleString('vi-VN')}đ
                            td 
                                div NL: #{item.stockAdult}
                                div TE: #{item.stockChildren}
                                div EB: #{item.stockBaby}
                            td(class="inner-center") #{item.position}
                            td(class="inner-center")
                                if(item.status === "active")
                                    .badge.badge-green Hoạt động
                                else if(item.status === "inactive")
                                    .badge.badge-red Tạm dừng  
                            td
                                div #{item.createdByFullName}
                                div.inner-time #{item.createdAtFormat}
                            td
                                div #{item.updatedByFullName}
                                div.inner-time #{item.updatedAtFormat}
                            td
                                .inner-buttons
                                    a(
                                    href=`/${pathAdmin}/tours/edit/${item.id}`
                                     class="inner-edit"
                                    ) <i class="fa-regular fa-pen-to-square"></i>
                                    button(
                                        class="inner-delete"
                                        button-delete
                                        data-api=`/${pathAdmin}/tours/delete/${item.id}`
                                        ) <i class="fa-regular fa-trash-can"></i>

    //- End Section-6
    
    //-Section-7
    .section-7 
        span(class="inner-label") Hiển thị #{pagination.skip + 1} - #{pagination.skip + tourList.length}  của #{pagination.totalRecord} 
        select(class="inner-pagination" pagination)
            - for (let i = 1; i <= pagination.totalPage; i++)
                option(value=i) Trang #{i}
    //- End Section-7
