extends ../layouts/default.pug


block main
    h2.box-title Thông tin website
    //- Section-8
    .section-8
        form#setting-website-info-form
            .inner-group 
                label(class="inner-label" for="createWeb") Tạo website
                input(type="text" id="createWeb" name="createWeb"  value= websiteInfo.createWebsite)
            .inner-group 
                label(class="inner-label" for="phone") Số điện thoại
                input(type="number" id="phone" name="phone"   value= websiteInfo.phone)
            .inner-group 
                label(class="inner-label" for="email") Email
                input(type="text" id="email" name="email" value= websiteInfo.email)
            .inner-group 
                label(class="inner-label" for="address") Địa chỉ
                input(type="text" id="address" name="address" value= websiteInfo.address)
            .inner-group.inner-two-col
                label(class="inner-label" for="logo") Logo
                div(class="inner-upload-image"  image-default=websiteInfo.logo )
                   input(type="file" id="logo" name="logo" accept="image/*" filepond-image)
            .inner-group.inner-two-col
                label(class="inner-label" for="favicon") Favicon
                div(class="inner-upload-image" image-default=websiteInfo.favicon)
                    input(type="file" id="favicon" name="favicon"  accept="image/*" filepond-image)
            .inner-group.inner-button
                button Cập nhật
        .inner-back 
            a(href=`/${pathAdmin}/setting/list`) Quay lại danh sách
    //-End Section-8
