mixin product-item(data)
  - const discount = (data.priceAdult - data.priceNewAdult) / data.priceAdult * 100;
  .product-item
    .inner-image
      a(href=`/tours/detail/${data.slug}`)
        img(
          alt=data.name
          src= data.avatar
          )
    .inner-discount
      i.fa-solid.fa-bolt
      | Giảm -#{discount}%
    .inner-content
      h3.inner-title
        a(href=`/tours/detail/${data.slug}`) #{data.name}
      .inner-prices
        if(discount > 0)
          .inner-price-old
            | #{data.priceAdult.toLocaleString("vi-VN")}
            span.inner-unit đ
        .inner-price-new
          | #{data.priceNewAdult.toLocaleString("vi-VN")}
          span.inner-unit đ
      .inner-desc
        //- .inner-desc-item
        //-   | Mã Tour:
        //-   b #{data.code}
        .inner-desc-item
          | Ngày Khởi Hành:
          b #{data.departureDateFormat}
        .inner-desc-item
          | Thời Gian:
          b #{data.time}
      .inner-meta
        .inner-rating
          .inner-stars
            - for(var i = 1; i <= data.ratingStars; i++)
              i.fa-solid.fa-star
            - for(var i = data.ratingStars + 1; i <= 5; i++)
              i.fa-regular.fa-star
          .inner-number (#{data.ratingTotal})
        .inner-stock
          .inner-label Số chỗ còn:
          .inner-number #{data.stockAdult}