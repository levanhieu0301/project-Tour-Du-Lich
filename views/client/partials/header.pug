// Top Header
.top-header
  .container
    .inner-wrap
      if(settingInfo.phone)
        .inner-item
          i.fa-solid.fa-phone
          | #{settingInfo.phone}
      if(settingInfo.email)
        .inner-item
          i.fa-solid.fa-envelope
          | #{settingInfo.email}
      if(settingInfo.address)
        .inner-item
          i.fa-solid.fa-building
          | #{settingInfo.address}
// End Top Header
// Header
header.header
  .container
    .inner-wrap
      button.inner-menu-mobile
        i.fa-solid.fa-bars
      .inner-logo
        a(href="/")
          img(
            alt=settingInfo.createWebsite
            src=settingInfo.logo
            )
      nav.inner-menu
        ul
          li
            a.active(href="/") Trang chủ
          each item in category
            li
              a(href=`/category/${item.slug}`) #{item.name}
              if(item.children.length > 0)
                i.fa-solid.fa-caret-down
                ul
                  each itemChild in item.children
                    li
                      a(href=`/category/${itemChild.slug}`) #{itemChild.name}
          li
            a(href="#") Tin Tức
          li
            a(href="#") Liên hệ
        .inner-overlay
      .inner-cart
        a(href="/cart")
          img(
            alt="Cart" 
            src="/assets/css/images/IconGioHang.svg"
            )
          span 1
// End Header