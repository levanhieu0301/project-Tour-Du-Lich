extends ../layouts/default.pug 
include ../mixins/breadcrumb.pug
//- include ../mixins/product-item.pug
block main
  // Box Breadcrumb
  //- -
  //-   var breadcrumb = {
  //-     image: "/assets/css/images/3-2.jpg",
  //-     title: "Tour Hà Nội - Ninh Bình - Hạ Long - Yên Tử - Sapa | 6N5D",
  //-     list: [
  //-       {
  //-         link: "/",
  //-         title: "Trang Chủ"
  //-       },
  //-       {
  //-         link: "/tours",
  //-         title: "Tour Trong Nước"
  //-       },
  //-       {
  //-         link: "/tours",
  //-         title: "Tour Miền Bắc"
  //-       },
  //-       {
  //-         link: "/tours/detail",
  //-         title: "Tour Hà Nội - Ninh Bình - Hạ Long - Yên Tử - Sapa | 6N5D"
  //-       }
  //-     ]
  //-   };
  +breadcrumb(breadcrumb)
  // End Box Breadcrumb
  // Section 10
  .section-10
    .container
      .inner-wrap
        .inner-left
          .box-images
            #images-main.inner-images-main
              .swiper.swiper-box-images-main
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      .inner-image
                        img(
                          alt="" 
                          src=image
                          )
            .inner-images-thumb
              .swiper.swiper-box-images-thumb
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      .inner-image
                        img(
                          alt="" 
                          src=image
                          )
          .box-tour-info
            .inner-title Thông Tin Tour
            .inner-content !{tourDetail.information}
            .inner-read-more
              button.button-outline Xem tất cả
          .box-tour-schedule
            .inner-title-main Lịch Trình Tour
            .inner-list
              each item in tourDetail.schedules
                .inner-item
                  .inner-title #{item.title}
                  .inner-content !{item.description}
        .inner-right
          .box-tour-detail
            .inner-title-main Chuyến Đi Của Bạn
            .inner-product
              .inner-image
                img(
                  alt="" 
                  src=tourDetail.avatar
                  )
              .inner-info
                .inner-title #{tourDetail.name}
                .inner-rating
                  .inner-stars
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                  .inner-number 500 lượt đánh giá
            .inner-meta
              .inner-item
                i.fa-solid.fa-ticket-simple
                span Mã Tour:
                span.inner-highlight 28T00001
              .inner-item
                i.fa-solid.fa-calendar-days
                span Thời Gian:
                span.inner-highlight #{tourDetail.time}
              .inner-item
                i.fa-solid.fa-car
                span Phương Tiện:
                span.inner-highlight #{tourDetail.vehicle}
              .inner-item
                i.fa-solid.fa-calendar-days
                span Ngày Khởi Hành:
                span.inner-highlight #{tourDetail.departureDateFormat}
            form.inner-form(action="")
              .inner-group
                label.inner-label Khởi Hành Tại:
                select(name="")
                  each city in cityList
                    option(value=city._id) #{city.name}
              .inner-group
                label.inner-label Số Lượng Hành Khách
                .inner-list
                  .inner-item
                    .inner-item-label Người lớn:
                    .inner-item-input
                      input(
                        min="0" 
                        max=tourDetail.stockAdult
                        value="1" 
                        name="" 
                        type="number"
                        )
                    .inner-item-price
                      span 1
                      span x
                      span.inner-highlight #{tourDetail.priceNewAdult.toLocaleString("vi-VN")} 
                  .inner-item
                    .inner-item-label Trẻ em:
                    .inner-item-input
                      input(
                        min="0" 
                        max=tourDetail.stockChild
                        value="0" 
                        name="" 
                        type="number"
                        )
                    .inner-item-price
                      span 0
                      span x
                      span.inner-highlight #{tourDetail.priceNewChildren.toLocaleString("vi-VN")} 
                  .inner-item
                    .inner-item-label Em bé:
                    .inner-item-input
                      input(
                        min="0" 
                        value="0" 
                        max = tourDetail.stockBaby
                        name="" 
                        type="number"
                        )
                    .inner-item-price
                      span 0
                      span x
                      span.inner-highlight #{tourDetail.priceNewBaby.toLocaleString("vi-VN")} 
              .inner-total
                .inner-total-label Tổng cộng:
                .inner-total-price #{tourDetail.priceNewAdult.toLocaleString("vi-VN")}đ
              button.inner-button-add-cart Thêm Vào Giỏ Hàng
  // End Section 10